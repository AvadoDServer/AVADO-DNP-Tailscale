{
  "name": "avado-tailscale",
  "version": "0.2.0",
  "private": true,
  "description": "AVADO Tailscale: runs tailscaled (userspace networking) and a plain-language page to log in and share the AVADO in the owner's tailnet",
  "license": "GPL-3.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.test.json --noEmit",
    "test": "rm -rf .test-build && tsc -p tsconfig.test.json && node --test .test-build/test/*.test.js",
    "start": "node dist/server.js"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "qrcode": "1.5.4"
  }
}
